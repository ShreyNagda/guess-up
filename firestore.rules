rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories / Decks collection - public read, authenticated admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Testers collection - public read & create/write for registration, authenticated admin delete
    match /testers/{testerId} {
      allow read: if true;
      allow create, update: if request.resource.data.email != null;
      allow delete: if request.auth != null;
    }

    // Feedback collection - public create only, authenticated admin read/update/delete
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Site Config collection - public read, authenticated admin write
    match /site_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
