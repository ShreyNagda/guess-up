rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories & Decks collections - allow read and write for app and admin management
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /decks/{deckId} {
      allow read, write: if true;
    }

    // Testers collection - allow read and write for playtester registration and admin export/management
    match /testers/{testerId} {
      allow read, write: if true;
    }

    // Feedback collection - allow read and write
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Site Config collection - allow read and write
    match /site_config/{configId} {
      allow read, write: if true;
    }

    // Fallback allow for root documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
