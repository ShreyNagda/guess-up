rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories / Decks collection - public read for all app users
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin@guessup.com";
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

